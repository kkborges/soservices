# ========================================
# CONFIGURACAO CENTRALIZADA - LAS OTEL
# ========================================
#
# Copie este arquivo para `.env` (ou carregue no runtime) e preencha os valores.
# Nao comite tokens reais.

# Credenciais LAS
LAS_ENDPOINT=https://api.soservices.com.br:8443/api/v1/ingest/otel
LAS_TOKEN=lsa_SUBSTITUA_ESTE_TOKEN

# Identificacao do Servico
SERVICE_NAME=las-application
SERVICE_VERSION=1.0.0
SERVICE_ENVIRONMENT=production
SERVICE_NAMESPACE=las

# Opcoes de Instrumentacao
ENABLE_RUM=true
ENABLE_METRICS=true
ENABLE_LOGS=true
TRACE_SAMPLE_RATE=1.0

# Certificados mTLS (opcional - quando usado fora do agente/gateway)
MTLS_ENABLED=false
MTLS_CERT_PATH=/path/to/client.crt
MTLS_KEY_PATH=/path/to/client.key
MTLS_CA_PATH=/path/to/ca.crt

# Proxy (se necessario)
HTTP_PROXY=
HTTPS_PROXY=

# Debug
DEBUG_MODE=false
