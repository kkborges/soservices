# LAS On-Prem HA Environment (.env.onprem)
# =======================================
# Copie este arquivo para `docker/.env.onprem` dentro do deploy on-premise.
# DICA: nao rotacione senhas do Postgres/Redis depois de criar volumes.

# Public endpoints (expostos via NPM)
ONPREM_PUBLIC_WEB_URL=http://las-onprem.local
ONPREM_PUBLIC_API_URL=http://api-onprem.local

# Port mapping (para testar side-by-side com o SaaS no mesmo host)
ONPREM_HTTP_PORT=8080
ONPREM_HTTPS_PORT=8443
ONPREM_NPM_UI_PORT=8181
ONPREM_MTLS_PORT=9443

# Database
POSTGRES_DB=las
POSTGRES_USER=las
POSTGRES_PASSWORD=change_me_strong
REPMGR_PASSWORD=change_me_strong_repmgr
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=change_me_strong_pgpool_admin

# Redis
REDIS_PASSWORD=change_me_strong_redis

# App secrets
SECRET_KEY=change_me_to_a_64_char_random_string
DEBUG=false

# Optional: AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai

