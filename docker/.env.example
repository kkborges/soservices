# LAS - Docker HA Environment (.env)
# =================================
# Copie este arquivo para `docker/.env` e mantenha-o persistente.
# Nao rotacione estes valores depois que volumes do Postgres/Redis forem criados,
# ou o cluster HA pode entrar em loop (ex.: repmgr "password authentication failed").
#
# DICA: Use valores fortes (64+ chars) e guarde em cofre (1Password/Vault/etc).

# URLs publicas (usadas em links, downloads e emails)
PLATFORM_URL=https://api.soservices.com.br
PUBLIC_WEB_URL=https://las.soservices.com.br

# Segredos base
SECRET_KEY=change_me_to_a_64_char_random_string

# Postgres (HA via pgpool/repmgr)
POSTGRES_DB=las
POSTGRES_USER=las
POSTGRES_PASSWORD=change_me_strong
REPMGR_PASSWORD=change_me_strong_repmgr
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=change_me_strong_pgpool_admin

# Redis (HA via replicas + sentinels + haproxy)
REDIS_PASSWORD=change_me_strong_redis

# Email (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=las@soservices.com.br

# IA (opcional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai

# Outros (opcional)
DEBUG=false

