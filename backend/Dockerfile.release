FROM python:3.12-slim AS builder

LABEL maintainer="LAS Plataforma de Monitoramento e Observabilidade"
LABEL description="LAS Platform Backend (release) - bytecode-only image"

# Keep the default release image lean: Playwright package stays installed (requirements),
# but browser downloads are optional and should live in a dedicated "synthetics" image.
ARG INCLUDE_PLAYWRIGHT_BROWSERS=0

# System deps for common wheels (psycopg/cryptography/etc)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

COPY requirements.txt .
RUN python -m venv /opt/venv && pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Optional: install Playwright browser assets for "synthetics" builds.
RUN if [ "$INCLUDE_PLAYWRIGHT_BROWSERS" = "1" ]; then \
      python -m playwright install chromium ; \
    fi

COPY . .

# Compile app code and remove sources to reduce exposure.
# NOTE: this is obfuscation-by-packaging (not perfect protection).
RUN python -m compileall -q /app/app && \
    find /app/app -type f -name '*.py' -delete


FROM python:3.12-slim

LABEL maintainer="LAS Plataforma de Monitoramento e Observabilidade"
LABEL version="4.0.0"
LABEL description="LAS Platform Backend (release) - FastAPI + Celery"

# Runtime dependencies.
# If you build a dedicated synthetics image (INCLUDE_PLAYWRIGHT_BROWSERS=1),
# you may also want the extra Chromium libraries (same as backend/Dockerfile).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    libssl3 \
    libffi8 \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Create non-root user
RUN adduser --disabled-password --gecos '' las && \
    chown -R las:las /app /opt/venv

USER las

CMD ["/bin/sh", "-lc", "gunicorn app.main:app --workers ${WORKERS:-1} --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --timeout 120 --access-logfile - --error-logfile -"]
