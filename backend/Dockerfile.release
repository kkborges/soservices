FROM python:3.12-slim AS builder

LABEL maintainer="LAS Plataforma de Monitoramento e Observabilidade"
LABEL description="LAS Platform Backend (release) - bytecode-only image"

# System deps for common wheels (psycopg/cryptography/etc)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY requirements.txt .
RUN python -m venv /opt/venv && pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Install Playwright browser assets (no OS deps here; runtime stage installs libs)
RUN python -m playwright install chromium 2>/dev/null || true

COPY . .

# Compile app code and remove sources to reduce exposure.
# NOTE: this is obfuscation-by-packaging (not perfect protection).
RUN python -m compileall -q /app/app && \
    find /app/app -type f -name '*.py' -delete


FROM python:3.12-slim

LABEL maintainer="LAS Plataforma de Monitoramento e Observabilidade"
LABEL version="4.0.0"
LABEL description="LAS Platform Backend (release) - FastAPI + Celery"

# Runtime dependencies (Chromium libs for Playwright are kept here, matching our base Dockerfile).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    libssl3 \
    libffi8 \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /ms-playwright /ms-playwright
COPY --from=builder /app /app

# Create non-root user
RUN adduser --disabled-password --gecos '' las && \
    chown -R las:las /app /ms-playwright /opt/venv

USER las

CMD ["/bin/sh", "-lc", "gunicorn app.main:app --workers ${WORKERS:-1} --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --timeout 120 --access-logfile - --error-logfile -"]
